def thermo.bath.ndfmin_spread
  (half_dofs : Slice Std.I64) (ndfmin : Std.I64) :
  Result thermo.bath.Spread
  := do
  let total ← thermo.bath.ndfmin_spread_loop0 half_dofs 0#i64 0#usize
  let (factor, denominator) ←
    if total > 0#i64
    then
      do
      let i ← 2#i64 * ndfmin
      let factor1 ← total - i
      let denominator1 ← 2#i64 * total
      ok (factor1, denominator1)
    else ok (1#i64, 2#i64)
  let numerators ←
    thermo.bath.ndfmin_spread_loop1 half_dofs factor (alloc.vec.Vec.new
      Std.I64) 0#usize
  ok { numerators, denominator }

/-- [newen_logic::thermo::dof::total_dof]:
    Source: 'crates/newen-logic/src/thermo/dof.rs', lines 22:0-30:1
    Visibility: public -/
def thermo.dof.total_dof
  (n_atoms : Std.U64) (solvent_constraints : Std.U64)
  (solute_constraints : Std.U64) (ndfmin : Std.I64) :
  Result Std.I64
  := do
  let i ← lift (UScalar.hcast .I64 n_atoms)
  let coordinates ← 3#i64 * i
  let i1 ← lift (UScalar.hcast .I64 solvent_constraints)
  let i2 ← coordinates - i1
  let i3 ← lift (UScalar.hcast .I64 solute_constraints)
  let i4 ← i2 - i3
  i4 - ndfmin

