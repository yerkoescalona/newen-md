TITLE
Two solute waters in SPC (LiveCoMS t_05 topology), EDS single-s over four end states
END
SYSTEM
         1       998
END
INITIALISE
        0       0       0       0
        1       0       0
        0
   210185     0.0
END
STEP
#   NSTLIM         T        DT
       10       0.0     0.002
END
BOUNDCOND
#      NTB    NDFMIN
         1         0
END
MULTIBATH
    weak-coupling
    1
    300.0  0.1
    1
    3000     1         1
END
COMTRANSROT
#     NSCM
    100000
END
PRINTOUT
#     NTPR      NTPP
         1         0
END
WRITETRAJ
         1         0         0         1         1         0         0
END
CONSTRAINT
#       NTC
        3
#       NTCP
        shake
#       NTCP0(1)
        0.0001
#       NTCS
        shake
#       NTCS0(1)
        0.0001
END
FORCE
     0        1         1        1     1  1
     3       3     6    3000
END
PAIRLIST
#       ALGORITHM       NSNB    RCUTP   RCUTL   SIZE    TYPE
        standard        1       0.8     1.4     0.4     chargegroup
END
NONBONDED
#   NLRELE
         1
#    APPAK      RCRF     EPSRF  NSLFEXCL
       0.0       1.4      78.5         1
#   NSHAPE    ASHAPE    NA2CLC     TOLA2    EPSLS
        -1       1.4         2    0.1E-9      0.0
#      NKX       NKY       NKZ       NK2
        10        10        10      100.0
#      NGX       NGY       NGZ    NASORD    NFDORD    NALIAS    NSPORD
        32        32        32         3         2         3       4
#   NQEVAL    FACCUR    NRDGRD    NWRGRD
    100000       1.6         0         0
#    NLRLJ    SLVDNS
         0      33.3
END
POSITIONRES
#   NTPOR  NTPORB  NTPORS    CPOR
        0       0       0   0.0
END
EDS
# EDS
  1
# FORM  NUMSTATES
  1     4
# S
  0.2
# EIR
  16.32  -43.66  12.99  14.35
END
