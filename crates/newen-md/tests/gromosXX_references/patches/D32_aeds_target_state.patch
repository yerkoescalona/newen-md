D32 (gromosXX 247c95c4): A-EDS target state 0 by default even if never sampled.
md++/src/algorithm/integration/eds.cc:252-261 start the search for the lowest mean of V_i - E_i^R at state 0 whatever its
visit count, and require more than one visit only of states 1..N-1: a never-sampled state 0 (mean 0, sigma 0) stays the
target while every sampled state has a mean above 0, a fake G for E_min (and b_max = 0 with BMAXTYPE 2). Fix: apply the
"more than one visit" rule to state 0 too; when no state qualifies, state 0 as before.

diff --git a/md++/src/algorithm/integration/eds.cc b/md++/src/algorithm/integration/eds.cc
--- a/md++/src/algorithm/integration/eds.cc
+++ b/md++/src/algorithm/integration/eds.cc
@@ -251,11 +251,14 @@
         sim.param().eds.avgenergy[state] = tempenergy;
         tempenergy = sim.param().eds.eiravgenergy[0];
         // find the state with the minimum average energy
+        // among the states sampled more than once; state 0 only when none is
         int targetstate = 0;
-        for (unsigned int is = 1; is < numstates; is++) {
-          if (tempenergy >= sim.param().eds.eiravgenergy[is] && sim.param().eds.visitcounts[is] > 1) {
+        bool sampled = false;
+        for (unsigned int is = 0; is < numstates; is++) {
+          if (sim.param().eds.visitcounts[is] > 1 && (!sampled || tempenergy >= sim.param().eds.eiravgenergy[is])) {
             targetstate = is;
             tempenergy = sim.param().eds.eiravgenergy[is];
+            sampled = true;
           }
         }
         double globminavg = sim.param().eds.eiravgenergy[targetstate];
