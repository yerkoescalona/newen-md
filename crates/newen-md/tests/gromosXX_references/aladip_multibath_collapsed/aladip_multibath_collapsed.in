TITLE
Alanine dipeptide solvated - full reference
Uses existing aladip.topo and aladip.conf from parent directory
NVE run for energy conservation check
END
SYSTEM
#      NPM      NSM 
  1  20
END
INITIALISE
#  NTIVEL  NTISHK  NTINHT  NTINHB
  0  0  0  0  1  0  1  0  210185  0.0
END
STEP
#   NSTLIM         T        DT
  100  0.0  0.002
END
BOUNDCOND
#      NTB    NDFMIN
  1  0
END
MULTIBATH
#   NBATHS
  weak-coupling  2  300.0  0.1  300.0  0.1  2  12  1  1  72  2  2
END
COMTRANSROT
#     NSCM
  10
END
PRINTOUT
#     NTPR      NTPP
  10  0
END
WRITETRAJ
#     NTWX     NTWSE      NTWV      NTWF      NTWE      NTWG      NTWB
  10  0  0  10  10  0  0
END
CONSTRAINT
#       NTC  NTCP  NTCP0(1)  NTCS  NTCS0(1)
  3  1  0.0001  1  0.0001
END
FORCE
#      NTF array
  1  1  1  1  1  1  2  12  72
END
PAIRLIST
#       ALGORITHM       NSNB    RCUTP   RCUTL   SIZE    TYPE
  standard  5  0.8  1.4  auto  chargegroup
END
NONBONDED
#   NLRELE
  1  0.0  1.4  62.0  1  -1  1.4  2  0.1E-9  0.0  10  10  10  100.0  32  32  32  3  2  3  4  100000  1.6  0  0  0  33.3
END
POSITIONRES
#   NTPOR  NTPORB  NTPORS    CPOR
  0  0  0  0.0
END
