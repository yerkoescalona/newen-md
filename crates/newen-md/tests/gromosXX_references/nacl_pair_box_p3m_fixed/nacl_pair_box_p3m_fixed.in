TITLE
Na+ Cl- ion pair in periodic box - P3M reference
Tests: P3M (NLRELE 3), NSHAPE 3, ASHAPE 1.4, grid 32^3, NASORD 3, NFDORD 2, NALIAS 3, NA2CLC 3, atomic cutoff
END
SYSTEM
#      NPM      NSM 
         1        0
END
INITIALISE
#  NTIVEL  NTISHK  NTINHT  NTINHB
        0       0       0       0
#  NTISHI  NTIRTC  NTICOM
        1       0       0
#  NTISTI
        0
#      IG   TEMPI
   210185     0.0
END
STEP
#   NSTLIM         T        DT
        10       0.0     0.002
END
BOUNDCOND
#      NTB    NDFMIN
         1         0
END
MULTIBATH
    weak-coupling
#   NBATHS
    1
#   TEMP0  TAU
    300.0  -1.0
#   DOFSET
    1
#   LAST   COM-BATH  IR-BATH
    2      1         1
END
COMTRANSROT
#     NSCM
    100000
END
PRINTOUT
#     NTPR      NTPP
         1         0
END
WRITETRAJ
#     NTWX     NTWSE      NTWV      NTWF      NTWE      NTWG      NTWB
         1         0         0         1         1         0         0
END
CONSTRAINT
#       NTC
        1
#       NTCP
        shake
#       NTCP0(1)
        0.0001
#       NTCS
        shake
#       NTCS0(1)
        0.0001
END
FORCE
#      NTF array
# bonds    angles    imp.     dihe     charge nonbonded
# H        H         H        H
     0        0         0        0     1  1
# NEGR    NRE(1)    NRE(2)    ...      NRE(NEGR)
     1     2
END
PAIRLIST
#       ALGORITHM       NSNB    RCUTP   RCUTL   SIZE    TYPE
        standard        1       0.9     0.9     auto    atomic
END
NONBONDED
#   NLRELE
         3
#    APPAK      RCRF     EPSRF  NSLFEXCL
       0.0       0.9       1.0         1
#   NSHAPE    ASHAPE    NA2CLC     TOLA2    EPSLS
         3       1.4         3    0.1E-9      0.0
#      NKX       NKY       NKZ      KCUT
        10        10        10     900.0
#      NGX       NGY       NGZ    NASORD    NFDORD    NALIAS    NSPORD
        32        32        32         3         2         3         4
#   NQEVAL    FACCUR    NRDGRD    NWRGDR
         0       1.0         0         0
#    NLRLJ    SLVDNS
         0      33.3
END
POSITIONRES
#   NTPOR  NTPORB  NTPORS    CPOR
        0       0       0   0.0
END
