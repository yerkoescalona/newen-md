TITLE
Alanine dipeptide + 20 SPC, two Nose-Hoover-chain baths of length 3 (MULTIBATH ALGORITHM 3):
solute at 300 K (tau 0.1), water at 350 K (tau 0.2), fresh start (NTINHT 1)
END
SYSTEM
#      NPM      NSM 
         1       20
END
INITIALISE
#  NTIVEL  NTISHK  NTINHT  NTINHB
        0       0       1       0
#  NTISHI  NTIRTC  NTICOM
        1       0       1
#  NTISTI
        0
#      IG   TEMPI
   210185     0.0
END
STEP
#   NSTLIM         T        DT
        50       0.0     0.002
END
BOUNDCOND
#      NTB    NDFMIN
         1         0
END
MULTIBATH
    nose-hoover-chains	3
#   NBATHS
    2
#   TEMP0(1..NBATHS)  TAU(1..NBATHS)
    300.0  0.1  350.0  0.2
#   DOFSET
    2
#   LAST(1..DOFSET)  COMBATH(1..DOFSET)  IRBATH(1..DOFSET)
    12  1  1  72  2  2
END
COMTRANSROT
#     NSCM
       10
END
PRINTOUT
#     NTPR      NTPP
        10         0
END
WRITETRAJ
#     NTWX     NTWSE      NTWV      NTWF      NTWE      NTWG      NTWB
         1         0         0         1         1         0         0
END
CONSTRAINT
#       NTC  NTCP  NTCP0(1)  NTCS  NTCS0(1)
        3    1     0.0001    1     0.0001
END
FORCE
#      NTF array
# bonds    angles    imp.     dihe     charge nonbonded
# H        H         H        H
     1        1         1        1     1  1
# NEGR    NRE(1)    NRE(2)    ...      NRE(NEGR)
     2     12      72
END
PAIRLIST
#       ALGORITHM       NSNB    RCUTP   RCUTL   SIZE    TYPE
        standard        5       0.8     1.4     auto    chargegroup
END
NONBONDED
#   NLRELE
         1
#    APPAK      RCRF     EPSRF  NSLFEXCL
       0.0       1.4      62.0         1
#   NSHAPE    ASHAPE    NA2CLC     TOLA2    EPSLS
        -1       1.4         2    0.1E-9      0.0
#      NKX       NKY       NKZ       NK2
        10        10        10      100.0
#      NGX       NGY       NGZ    NASORD    NFDORD    NALIAS    NSPORD
        32        32        32         3         2         3         4
#   NQEVAL    FACCUR    NRDGRD    NWRGDR
    100000       1.6         0         0
#    NLRLJ    SLVDNS
         0      33.3
END
POSITIONRES
#   NTPOR  NTPORB  NTPORS    CPOR
        0       0       0   0.0
END
